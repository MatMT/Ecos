{
  "name": "ecos",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "concurrently -n server,mobile -c blue,magenta \"pnpm --filter server dev\" \"pnpm --filter mobile dev\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:reset": "pnpm --filter server db:reset"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "^2"
  }
}
