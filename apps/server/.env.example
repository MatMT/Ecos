# Application Config
PORT=6622

# Database Config (Supabase Postgres)
# DATABASE_URL: used ONLY by the Prisma CLI (migrate/generate/prisma.config.ts) — connects as the
# postgres superuser because migrations need DDL rights and must bypass RLS to run at all.
# Replace with your actual database credentials when copying to .env
DATABASE_URL="postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:54322/postgres"

# APP_DATABASE_URL: used by the running server (PrismaService) at request time — connects as
# `authenticator`, a non-BYPASSRLS role, so Row Level Security policies are actually enforced.
# Same password as POSTGRES_PASSWORD (see infra/supabase/volumes/db/roles.sql).
APP_DATABASE_URL="postgresql://authenticator:your-super-secret-and-long-postgres-password@localhost:54322/postgres"

# Supabase Auth (GoTrue), reached through the self-hosted stack's API gateway (Envoy).
SUPABASE_AUTH_URL="http://localhost:8000/auth/v1"
SUPABASE_ANON_KEY="copy-from-infra/supabase/.env-ANON_KEY"
# Server-only secret — never expose to any client. Used solely for GoTrue's Admin API (user
# provisioning) in AuthService.adminCreateUser.
SUPABASE_SERVICE_ROLE_KEY="copy-from-infra/supabase/.env-SERVICE_ROLE_KEY"
# Same HS256 secret GoTrue signs access tokens with — lets Nest verify JWTs locally, no network hop.
SUPABASE_JWT_SECRET="copy-from-infra/supabase/.env-JWT_SECRET"
